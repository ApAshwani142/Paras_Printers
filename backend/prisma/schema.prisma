datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  STAFF
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  subtitle       String?
  description    String
  features       String[]
  applications   String[]
  materials      String[]
  minOrderQty    Int       @default(1000)
  images         String[]
  isFeatured     Boolean   @default(false)
  technicalSpecs Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model QuoteRequest {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  email         String
  phone         String
  productType   String
  quantity      Int
  material      String?
  dimensions    String?
  customNotes   String?
  status        Status   @default(PENDING)
  createdAt     DateTime @default(now())
}

model ContactEnquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  author      String
  coverImage  String
  tags        String[]
  publishedAt DateTime @default(now())
}
